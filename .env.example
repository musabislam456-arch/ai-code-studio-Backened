# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Cloud (free tier) — get a key at https://ollama.com/settings/keys
# Only needed if you pick an "ollama:..." model from the model dropdown.
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# Optional: point at a self-hosted Ollama instance instead of ollama.com
OLLAMA_BASE_URL=https://ollama.com

# Groq (free tier, no credit card) — get a key at https://console.groq.com/keys
# Only needed if you pick a "groq:..." model from the model dropdown.
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (free ":free" models, no credit card) — get a key at
# https://openrouter.ai/keys. Only needed if you pick an "openrouter:...".
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cerebras (free tier, no credit card) — get a key at
# https://cloud.cerebras.ai. Only needed if you pick a "cerebras:...".
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Mistral La Plateforme (free "Experiment" tier — enable it in the Mistral
# console first) — get a key at https://console.mistral.ai/api-keys. Only
# needed if you pick a "mistral:...".
MISTRAL_API_KEY=your_mistral_api_key_here

# GitHub (server-side only)
GITHUB_TOKEN=your_github_token_here
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Persistence
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: Postgres "Public Networking" / TCP proxy URL (Railway -> Postgres
# service -> Settings -> Networking -> Public Networking -> Connect). Backend
# auto-falls-back to this if DATABASE_URL's *.railway.internal host can't be
# resolved (private networking unreachable between services).
DATABASE_PUBLIC_URL=
DATABASE_SSL=true
WORKSPACES_ROOT=/data/workspaces

# App
PORT=5175
APP_ACCESS_TOKEN=legacy_admin_token_optional
ALLOWED_ORIGIN=https://ai-code-studio-front.vercel.app

# Google OAuth — create these in Google Cloud Console
GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://ai-code-studio-backened-production.up.railway.app/api/auth/google/callback
FRONTEND_URL=https://ai-code-studio-front.vercel.app

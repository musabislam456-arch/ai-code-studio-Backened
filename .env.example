# Copy this to .env and fill in your real keys. Never commit .env.
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com
PORT=5175
WORKSPACES_ROOT=./workspaces

# --- Deployment / security ---
# Any random long string. The frontend must send this back on every
# request (via the login screen). Without this set, auth is OFF —
# fine for local dev, NEVER leave unset in production.
APP_ACCESS_TOKEN=change_this_to_a_long_random_string

# Set this to your deployed frontend URL once you deploy to Vercel,
# e.g. https://ai-code-studio.vercel.app
ALLOWED_ORIGIN=
